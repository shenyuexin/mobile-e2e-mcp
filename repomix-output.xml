      supportLevel: "full",
      content: snapshot.readExecution.stdout,
      summary: snapshot.summary,
    },
    nextSuggestions:
      resolution.status === "resolved"
        ? []
        : buildResolutionNextSuggestions(
            resolution.status,
            "resolve_ui_target",
