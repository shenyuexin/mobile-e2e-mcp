  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Technology Stack",
      "items": [
        "TypeScript + pnpm monorepo with packages/contracts, core, adapter-vision, adapter-maestro, explorer, mcp-server",
        "MCP SDK entrypoint publishes @shenyuexin/mobile-e2e-mcp and exposes typed tool wrappers",
        "Android uses ADB and UIAutomator; iOS uses AXe, WDA, simctl, and devicectl depending on target"
      ]
    },
    {
      "dot": "rose",
      "title": "Decision Flow",
      "items": [
        "Tool request is validated against policy profile, session context, and typed contracts before execution",
        "Router chooses platform/backend by device, framework profile, requested capability, and policy constraints",
        "Execution must prefer stable IDs, tree, and semantic matching before any OCR/CV path"
      ]
    },
    {
      "dot": "violet",
      "title": "Evidence + Recovery Loop",
      "items": [
        "Every action should preserve status, reasonCode, attempts, artifacts, data, and nextSuggestions",
        "Screenshots, UI trees, logs, crash signals, performance traces, and replay events attach to the session timeline",
        "Failures feed interruption handling, attribution, remediation suggestions, checkpoint replay, or manual handoff"
      ]
    }
  ]
