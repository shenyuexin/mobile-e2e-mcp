  assert.deepEqual(
    perfTool?.promotionGate,
    {
      blocked: true,
      requiredProofLanes: ["simulator", "real_device"],
      blockingReasons: ["Support promotion is blocked until simulator proof and real-device proof lanes are both explicitly established."],
    },
  );
