    | { type: 'auto-login'; credentials: TestCredentials };

  // --- Failure Policy ---
  failureStrategy: 'retry-3' | 'skip' | 'handoff';

  // --- Depth Control ---
  maxDepth: number;        // 5 (shallow) | 8 (standard) | 12 (deep)
