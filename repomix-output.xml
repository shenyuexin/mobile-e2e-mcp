    executeStep: async ({ replayStep }) => replayStep.stepNumber === 1
      ? {
          ...successResult(replayStep.actionType as ActionIntent["actionType"], "action-1"),
          status: "partial",
          reasonCode: "OK",
          data: {
            ...successResult(replayStep.actionType as ActionIntent["actionType"], "action-1").data,
            retryDecisionTrace: {
